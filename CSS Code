  content: "";
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-30%);
  width: 28px;
  height: 100px;
  background-image: url("https://64.media.tumblr.com/12d23b38fca2791156a5bf364d444c73/0e1cd4e515836ff6-3e/s250x400/365026cda26043a0aeba081c9930737d51552e86.png");
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
}

.splash .favorite {
  position: relative;
}

.splash .favorite::after {
  content: "𝑷𝒆𝒐𝒑𝒍𝒆 𝒂𝒓𝒆 𝒂𝒍𝒘𝒂𝒚𝒔 𝒔𝒐 𝒔𝒘𝒆𝒂𝒕𝒚 𝒘𝒉𝒆𝒏 𝒚𝒐𝒖 𝒌𝒊𝒍𝒍 𝒕𝒉𝒆𝒎. 𝑱𝒖𝒔𝒕, 𝒍𝒊𝒌𝒆, 𝒐𝒊𝒍𝒚.";
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  transform: translateY(15px);
  border-radius: 10px;
  background: rgba(18, 16, 14, 0.7);
  text-align: center;
  font-size: 11px;
  color: #DEE2D6;
  opacity: 1;
  white-space: pre;
}

